@model IEnumerable<Techcrafts.Blogging.Application.Features.Posts.Queries.PostDto>

@foreach (var post in Model)
{
    <article class="d-flex flex-column flex-md-row gap-4 p-4 card hover-lift text-decoration-none position-relative">
        @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
        {
            <div class="flex-shrink-0 mx-auto mx-md-0" style="width: 100%; max-width: 280px;">
                <div class="rounded overflow-hidden" style="height: 180px;">
                    <img src="@post.FeaturedImageUrl" class="w-100 h-100 object-fit-cover" alt="Header image for @post.Title" />
                </div>
            </div>
        }
        
        <div class="flex-grow-1 d-flex flex-column justify-content-between">
            <div>
                <div class="text-muted small fw-medium mb-2">
                    @post.PublishedDate?.ToString("MMM dd, yyyy")
                </div>
                <h3 class="h4 mb-2"><a href="/posts/@post.Slug" class="text-main stretched-link">@post.Title</a></h3>
                <p class="text-muted mb-3 line-clamp-2">@post.Summary</p>
            </div>
            
            <div class="d-flex align-items-center flex-wrap gap-3 text-muted small fw-medium mt-3 mt-md-auto">
                <span><i class="bi bi-clock me-1"></i> @post.ReadingTimeMinutes min read</span>
                @if(post.Tags.Any())
                {
                    foreach(var tag in post.Tags.Take(3))
                    {
                        <span class="badge bg-surface border z-1 position-relative">@tag.Name</span>
                    }
                }
                else
                {
                    <span class="badge bg-surface border z-1 position-relative">Engineering</span>
                }
            </div>
        </div>
    </article>
}
