@using Techcrafts.Blogging.Application.Features.Posts.Queries
@using Techcrafts.Blogging.Domain.Enums
@model PaginatedAdminPostsDto

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Posts";
    var currentStatus = (PostStatus?)ViewBag.Status;
    var search = (string?)ViewBag.Search;
    var sortBy = (string?)ViewBag.SortBy ?? "created_desc";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0" style="letter-spacing: -0.02em;">Blog Posts</h2>
        <p class="text-muted small m-0 mt-1">Manage, draft, publish, and audit your publication content.</p>
    </div>
    <a href="/admin/create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> New Post
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Status Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link @(currentStatus == null ? "active" : "")" href="/admin/posts?sortBy=@sortBy@(string.IsNullOrWhiteSpace(search) ? "" : $"&search={search}")">
            All <span class="badge bg-secondary ms-1">@Model.TotalCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == PostStatus.Published ? "active" : "")" href="/admin/posts?status=Published&sortBy=@sortBy@(string.IsNullOrWhiteSpace(search) ? "" : $"&search={search}")">
            Published <span class="badge bg-secondary ms-1">@Model.TotalPublished</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == PostStatus.Draft ? "active" : "")" href="/admin/posts?status=Draft&sortBy=@sortBy@(string.IsNullOrWhiteSpace(search) ? "" : $"&search={search}")">
            Drafts <span class="badge bg-secondary ms-1">@Model.TotalDrafts</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == PostStatus.Scheduled ? "active" : "")" href="/admin/posts?status=Scheduled&sortBy=@sortBy@(string.IsNullOrWhiteSpace(search) ? "" : $"&search={search}")">
            Scheduled <span class="badge bg-secondary ms-1">@Model.TotalScheduled</span>
        </a>
    </li>
</ul>

<!-- Filter and Search Bar -->
<div class="card border-0 shadow-sm rounded-4 bg-surface p-3 mb-4">
    <form method="get" action="/admin/posts" class="row g-2 align-items-center">
        @if (currentStatus.HasValue)
        {
            <input type="hidden" name="status" value="@currentStatus" />
        }
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Search by title, summary, or slug..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="sortBy" class="form-select" onchange="this.form.submit()">
                <option value="created_desc" selected="@(sortBy == "created_desc")">Newest Created First</option>
                <option value="created_asc" selected="@(sortBy == "created_asc")">Oldest Created First</option>
                <option value="title_asc" selected="@(sortBy == "title_asc")">Title (A-Z)</option>
                <option value="title_desc" selected="@(sortBy == "title_desc")">Title (Z-A)</option>
                <option value="views_desc" selected="@(sortBy == "views_desc")">Most Viewed</option>
                <option value="published_desc" selected="@(sortBy == "published_desc")">Recently Published</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-secondary w-100">Filter</button>
            @if (!string.IsNullOrWhiteSpace(search) || currentStatus.HasValue)
            {
                <a href="/admin/posts" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </form>
</div>

<!-- Posts Data Grid -->
<div class="card border-0 shadow-sm rounded-4 bg-surface overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="min-width: 250px;">Title</th>
                    <th scope="col">Author</th>
                    <th scope="col">Status</th>
                    <th scope="col">Created</th>
                    <th scope="col">Published</th>
                    <th scope="col" class="text-center">Views</th>
                    <th scope="col" class="text-end" style="min-width: 220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Posts == null || !Model.Posts.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                            No posts found matching the selected criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var post in Model.Posts)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-main">@post.Title</div>
                                <div class="text-muted small font-monospace">/@post.Slug</div>
                                @if (post.Tags != null && post.Tags.Any())
                                {
                                    <div class="mt-1">
                                        @foreach (var tag in post.Tags)
                                        {
                                            <span class="badge bg-dark border text-muted small me-1">@tag</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@post.AuthorName</span>
                            </td>
                            <td>
                                @if (post.Status == PostStatus.Published)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Published</span>
                                }
                                else if (post.Status == PostStatus.Draft)
                                {
                                    <span class="badge bg-secondary-subtle text-light border border-secondary-subtle">Draft</span>
                                }
                                else if (post.Status == PostStatus.Scheduled)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Scheduled</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark text-muted border">Archived</span>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@post.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span>
                            </td>
                            <td>
                                <span class="small text-muted">@(post.PublishedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-dark text-light border">@post.ViewCount</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="/admin/posts/@post.Id/edit" class="btn btn-outline-primary" title="Edit Post">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="/admin/posts/@post.Id/preview" class="btn btn-outline-secondary" title="Admin Preview">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (post.Status == PostStatus.Published)
                                    {
                                        <a href="/posts/@post.Slug" target="_blank" class="btn btn-outline-info" title="View Public Post">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                        <form method="post" action="/admin/posts/@post.Id/unpublish" class="d-inline" onsubmit="return confirm('Move this post to Drafts? It will no longer be visible publicly.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Unpublish">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" action="/admin/posts/@post.Id/publish" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Publish Post">
                                                <i class="bi bi-cloud-upload"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" action="/admin/posts/@post.Id/delete" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this post? This action cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Post">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent border-top border-subtle d-flex justify-content-between align-items-center py-3">
            <div class="text-muted small">
                Showing page @Model.Page of @Model.TotalPages (@Model.TotalCount total posts)
            </div>
            <nav aria-label="Posts pagination">
                <ul class="pagination pagination-sm m-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="/admin/posts?page=@(Model.Page - 1)&pageSize=@Model.PageSize&sortBy=@sortBy@(currentStatus.HasValue ? $"&status={currentStatus}" : "")@(string.IsNullOrWhiteSpace(search) ? "" : $"&search={search}")">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" href="/admin/posts?page=@p&pageSize=@Model.PageSize&sortBy=@sortBy@(currentStatus.HasValue ? $"&status={currentStatus}" : "")@(string.IsNullOrWhiteSpace(search) ? "" : $"&search={search}")">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/admin/posts?page=@(Model.Page + 1)&pageSize=@Model.PageSize&sortBy=@sortBy@(currentStatus.HasValue ? $"&status={currentStatus}" : "")@(string.IsNullOrWhiteSpace(search) ? "" : $"&search={search}")">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
