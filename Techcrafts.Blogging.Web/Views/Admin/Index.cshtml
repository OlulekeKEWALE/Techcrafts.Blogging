@{ Layout = "_AdminLayout"; }
@using Techcrafts.Blogging.Application.Features.Posts.Queries
@using Techcrafts.Blogging.Domain.Enums

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0" style="letter-spacing: -0.02em;">Dashboard</h2>
    <div class="d-flex gap-2">
        <a href="/admin/posts" class="btn btn-outline-secondary">
            <i class="bi bi-journal-text me-1"></i> Manage Posts
        </a>
        <a href="/admin/create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Post
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 bg-surface p-4 h-100">
            <h6 class="text-muted text-uppercase fw-bold small mb-2"><i class="bi bi-file-earmark-text me-2"></i>Total Posts</h6>
            <div class="display-5 fw-bold text-main">@ViewBag.TotalPosts</div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 bg-surface p-4 h-100">
            <h6 class="text-muted text-uppercase fw-bold small mb-2"><i class="bi bi-eye me-2"></i>Total Views</h6>
            <div class="display-5 fw-bold text-main">@ViewBag.TotalViews</div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 bg-surface p-4 h-100">
            <h6 class="text-muted text-uppercase fw-bold small mb-2"><i class="bi bi-people me-2"></i>Active Users</h6>
            <div class="display-5 fw-bold text-main">@ViewBag.TotalUsers</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 bg-surface p-4 h-100">
            <h6 class="text-muted text-uppercase fw-bold small mb-2"><i class="bi bi-hand-thumbs-up me-2"></i>Total Likes</h6>
            <div class="display-5 fw-bold text-main">@ViewBag.TotalLikes</div>
        </div>
    </div>
</div>

<!-- Recent Posts Section -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 bg-surface p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold m-0"><i class="bi bi-clock-history me-2 text-muted"></i>Recent Posts</h5>
                <a href="/admin/posts" class="btn btn-sm btn-outline-secondary rounded-pill">View All Posts</a>
            </div>

            @{
                var recentPosts = (List<AdminPostListItemDto>?)ViewBag.RecentPosts;
            }

            @if (recentPosts == null || !recentPosts.Any())
            {
                <p class="text-muted">No posts found in the system yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Views</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in recentPosts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@post.Title</div>
                                        <div class="text-muted small font-monospace">/@post.Slug</div>
                                    </td>
                                    <td>
                                        @if (post.Status == PostStatus.Published)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-light border border-secondary-subtle">Draft</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@post.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-dark border">@post.ViewCount</span></td>
                                    <td class="text-end">
                                        <a href="/admin/posts/@post.Id/edit" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
