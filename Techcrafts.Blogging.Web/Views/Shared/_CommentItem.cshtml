@using Techcrafts.Blogging.Application.Features.Comments.Queries
@model CommentDto

<div class="d-flex mb-4" id="comment-@Model.Id">
    <div class="flex-shrink-0">
        <img src="@(Model.AuthorAvatarUrl ?? "https://ui-avatars.com/api/?name=User&background=random")" alt="@Model.AuthorName" class="rounded-circle border" style="width: 48px; height: 48px; object-fit: cover;" />
    </div>
    <div class="ms-3 flex-grow-1">
        <div class="d-flex align-items-center mb-1">
            <h6 class="fw-bold mb-0 me-2">@Model.AuthorName</h6>
            <small class="text-muted">@Model.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</small>
            @if (Model.Status == "Pending")
            {
                <span class="badge bg-warning text-dark ms-2" style="font-size: 0.65rem;">Pending Moderation</span>
            }
        </div>
        <div class="prose text-muted mb-2">
            <p class="mb-0">@Model.Content</p>
        </div>
        
        <button class="btn btn-sm btn-link text-decoration-none p-0 fw-medium btn-reply" data-comment-id="@Model.Id" style="font-size: 0.85rem;">
            <i class="bi bi-reply-fill"></i> Reply
        </button>
        
        <!-- Reply Form Container (hidden initially) -->
        <div id="reply-container-@Model.Id" class="mt-3 d-none">
        </div>

        <!-- Render Replies -->
        @if (Model.Replies != null && Model.Replies.Any())
        {
            <div class="mt-4 border-start border-2 border-subtle ps-4">
                @foreach (var reply in Model.Replies)
                {
                    @await Html.PartialAsync("_CommentItem", reply)
                }
            </div>
        }
    </div>
</div>
