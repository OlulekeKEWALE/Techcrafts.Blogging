@* @model Guid? // PostId *@
<div class="card p-4 border-0 mb-5 shadow-sm" style="background-color: var(--bg-surface);">
    <h5 class="fw-bold mb-4">Leave a Comment</h5>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity.Name;
        var name = User.FindFirst("urn:github:name")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? email?.Split('@')[0];
        var avatarUrl = User.FindFirst("urn:github:avatar_url")?.Value ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(name ?? "U")}&background=random";

        <div class="d-flex align-items-center justify-content-between mb-3 p-3 border border-subtle rounded bg-card">
            <div class="d-flex align-items-center gap-3">
                <img src="@avatarUrl" alt="Avatar" class="rounded-circle border" width="40" height="40" />
                <div>
                    <div class="fw-bold lh-sm">@name</div>
                    <div class="text-muted small">@email</div>
                </div>
            </div>
            <form method="post" action="/account/logout">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path#comments" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Sign Out</button>
            </form>
        </div>

        <form id="comment-form" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PostId" value="@Model" />
            <div class="mb-3">
                <textarea name="Content" class="form-control bg-card" rows="4" placeholder="Share your thoughts on this architecture..." required></textarea>
            </div>
            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary px-4">Post Comment</button>
            </div>
        </form>
    }
    else
    {
        <div class="text-center py-4">
            <div class="mb-3 text-muted">Join the discussion to share your thoughts.</div>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <!-- Google Auth -->
                <form method="post" action="/account/external-login" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="Google" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path#comments" />
                    <button type="submit" class="btn btn-light border-subtle fw-medium d-flex align-items-center gap-2">
                        <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                        Google
                    </button>
                </form>

                <!-- GitHub Auth -->
                <form method="post" action="/account/external-login" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="GitHub" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path#comments" />
                    <button type="submit" class="btn btn-dark fw-medium d-flex align-items-center gap-2">
                        <i class="bi bi-github"></i> GitHub
                    </button>
                </form>

                <!-- Email Auth Modal Trigger -->
                <button type="button" class="btn btn-secondary fw-medium" data-bs-toggle="modal" data-bs-target="#emailAuthModal">
                    <i class="bi bi-envelope"></i> Email
                </button>
            </div>
        </div>
    }
</div>

@if (User.Identity?.IsAuthenticated != true)
{
    @await Html.PartialAsync("_CommentAuthModal")
}
