<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Standard SEO -->
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - Oluleke OKEWALE" : "Oluleke OKEWALE - Software Engineer")</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Thoughts, tutorials, and insights on software engineering and technology by Oluleke OKEWALE.")" />
    <meta name="keywords" content="@(ViewData["MetaKeywords"] ?? "software engineering, .net, programming, web development")" />
    <meta name="author" content="Oluleke OKEWALE" />
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />

    <!-- Open Graph (Social Sharing) -->
    <meta property="og:title" content="@(ViewData["Title"] ?? "Oluleke OKEWALE")" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Insights on software engineering.")" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? Context.Request.Scheme + "://" + Context.Request.Host + "/images/logo.png")" />
    <meta property="og:site_name" content="Techcrafts Blogging" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] ?? "Oluleke OKEWALE")" />
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "Insights on software engineering.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? Context.Request.Scheme + "://" + Context.Request.Host + "/images/logo.png")" />

    @if (ViewData["ArticleTags"] is string[] articleTags)
    {
        foreach (var tag in articleTags)
        {
            <meta property="article:tag" content="@tag" />
        }
    }
    
    <!-- Theme Script to prevent FOUC (Flash of Unstyled Content) -->
    <script>
        const getPreferredTheme = () => {
            const storedTheme = localStorage.getItem('theme');
            if (storedTheme) {
                return storedTheme;
            }
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-bs-theme', getPreferredTheme());
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
    <header class="border-bottom border-subtle">
        <nav class="navbar navbar-expand-lg navbar-light bg-main py-3">
            <div class="container max-w-6xl">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Posts" asp-action="Index">
                    <img src="~/images/logo.png" alt="Techcrafts Logo" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border-subtle);" />
                     Oluleke OKEWALE
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Articles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/About">About</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <button id="btn-theme-toggle" class="theme-toggle">
                            <i class="bi bi-moon-stars-fill dark-icon d-none"></i>
                            <i class="bi bi-sun-fill light-icon d-none"></i>
                        </button>
                        <a href="/admin" class="btn btn-sm btn-secondary">Dashboard</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container max-w-6xl my-5 py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-subtle py-5 mt-5 bg-surface text-center">
        <div class="container max-w-3xl text-muted small">
            &copy; 2026 Techcrafts Engineering &mdash; <a href="/Home/Privacy" class="text-muted text-decoration-underline">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Theme Toggle Logic
            const updateIcon = (theme) => {
                if (theme === 'dark') {
                    $('.dark-icon').removeClass('d-none');
                    $('.light-icon').addClass('d-none');
                } else {
                    $('.light-icon').removeClass('d-none');
                    $('.dark-icon').addClass('d-none');
                }
            };
            
            let currentTheme = document.documentElement.getAttribute('data-bs-theme');
            updateIcon(currentTheme);
            
            $('#btn-theme-toggle').click(function() {
                currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', currentTheme);
                localStorage.setItem('theme', currentTheme);
                updateIcon(currentTheme);
            });
        });
    </script>
    
    <script src="~/js/engagement.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
